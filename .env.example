# ============================================================
#  remnawave-admin — конфигурация окружения
#  Скопируйте в .env и заполните:  cp .env.example .env
# ============================================================

# Порт веб-админки на хосте
ADMIN_PORT=8090
TZ=Europe/Moscow
LOG_LEVEL=INFO

# СЕКРЕТ приложения. Сгенерируйте: openssl rand -hex 32
# ВАЖЕН: на нём шифруется секрет eXpress-бота. При смене секрета старый
# секрет бота не прочитается — введите его заново в разделе «Бот».
SECRET_KEY=CHANGE_ME_random_hex_64_chars

# Первый администратор админки (создаётся при первом запуске).
# Если ADMIN_PASSWORD пустой — сгенерируется случайный и будет
# напечатан в логах контейнера ровно один раз.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Время жизни сессии, часы
SESSION_HOURS=12

# --- Подключение к панели Remnawave (обязательно) ---
# Полный URL панели, например: https://panel.example.com  (без «/» в конце)
REMNAWAVE_BASE_URL=

# СПОСОБ 1 (рекомендуется): API-токен панели.
# Панель Remnawave -> Settings -> API Tokens -> создать токен.
REMNAWAVE_API_TOKEN=

# СПОСОБ 2: учётная запись панели (логин/пароль от панели).
# Используется, если токен не задан.
REMNAWAVE_USERNAME=
REMNAWAVE_PASSWORD=
